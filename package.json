{
  "name": "forgeflow",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.10",
    "marked": "18.0.14",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:helpers": "node scripts/run-tests.js --helpers",
    "test:visual-capabilities": "playwright test --config playwright.visual.config.ts",
    "test:native-release": "node tests/native-release/qualification.cjs",
    "test:web-release": "playwright test --config playwright.release.config.ts",
    "test:services": "node scripts/run-tests.js --services",
    "typecheck": "tsc -p services/chat-bridge/tsconfig.json --noEmit",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check"
  }
}
