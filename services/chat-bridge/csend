#!/bin/bash
# csend — fire-and-forget chat message sender for Forgeflow agents
# Usage: csend <agent> <level> <message> [activity-label]
#   agent: product_lead | builder | guardian | designer | coordinator | architect | verifier
#   level: phase | decision | conversation
# Failures are always silent — never breaks agent execution.

set -euo pipefail

agent="${1:-}"
level="${2:-}"
message="${3:-}"
activity_label="${4:-}"
activity_supplied="${4+x}"

if [ -z "$agent" ] || [ -z "$level" ] || [ -z "$message" ]; then
  exit 0
fi

port="${CHAT_BRIDGE_PORT:-4002}"
token_file="${TOKEN_FILE:-}"
token=""
if [ -n "$token_file" ] && [ -r "$token_file" ]; then
  token="$(cat "$token_file")"
fi
if [ -z "$token" ]; then
  exit 0
fi
body=$(jq -n --arg a "$agent" --arg l "$level" --arg m "$message" --arg activity "$activity_label" --arg supplied "$activity_supplied" \
  '{agent: $a, level: $l, message: $m} + (if $supplied == "" then {} else {activityLabel: $activity} end)')

printf 'X-Forgeflow-Token: %s\n' "$token" | curl -s --max-time 1 --header @- \
  -X POST \
  -H "Content-Type: application/json" \
  -d "$body" \
  "http://127.0.0.1:${port}/send" \
  > /dev/null 2>&1 || true
